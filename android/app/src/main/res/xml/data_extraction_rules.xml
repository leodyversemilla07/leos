<?xml version="1.0" encoding="utf-8"?>
<!--
  A wallet holds money, so nothing about it belongs in a backup. The
  device keystore holds the key that encrypts the session, and that key
  cannot leave the device anyway.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
